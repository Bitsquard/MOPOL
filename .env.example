# ---------- Supabase (optional — app runs on local vault until set) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- AI provider (optional — offline extractive engine by default) ----------
# Any OpenAI-compatible endpoint works: OpenAI, Groq, OpenRouter, Together…
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---------- Proof receipt signing secret ----------
MOPOL_SECRET=change-me-in-production
